projection;
strict ( 2 );

use draft;
use side effects;
define behavior for Z8PM_TRAVEL_PROCESSOR alias Travel
implementation in class ZBP_8PM_TRAVEL_PROC unique
{
  use create (augment, precheck);
  use update (precheck);
  use delete;

  use action Prepare;
  use action Edit;
  use action Discard;
  use action Resume;
  use action Activate;


  use association _Booking { create; with draft; }
}

define behavior for Z8PM_BOOKING_PROCESSOR alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _BookSuppl { create; with draft; }
}

define behavior for Z8PM_BOOKSUPPL_PROCESSOR alias BookSuppl
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}